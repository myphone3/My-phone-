# העתק קובץ זה ל-.env.local ומלא את הערכים שלך מ-Supabase
# (Project Settings > API בפרויקט ה-Supabase שלך)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# מספר הוואטסאפ העסקי שלך לקבלת הזמנות, בפורמט בינלאומי בלי + או רווחים
# לדוגמה: מספר 050-1234567 -> 972501234567
NEXT_PUBLIC_WHATSAPP_NUMBER=972500000000
