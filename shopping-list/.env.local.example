NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# אופציונלי: חיפוש תמונות בגוגל (Programmable Search Engine עם חיפוש תמונות)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# התראות לטלפון (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# סידור חכם: עובד אוטומטית ב-Vercel דרך AI Gateway. אפשר לשנות מודל:
AI_MODEL=google/gemini-2.5-flash-lite
